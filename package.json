{
  "name": "pulse",
  "productName": "Pulse",
  "version": "0.1.0",
  "description": "macOS personalized news & intelligence dashboard",
  "main": "out/main/index.js",
  "author": "Ashwin Sreedhar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "lint": "tsc --noEmit",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "com.ashwin.pulse",
    "productName": "Pulse",
    "copyright": "© 2026 Ashwin Sreedhar",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icons/**/*",
      "!**/*.{md,map,d.ts}",
      "!**/{.DS_Store,.git,.vscode,test,tests,docs,*.log}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "resources/icons/appIcon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.14.1",
    "@mozilla/readability": "^0.6.0",
    "@types/dompurify": "^3.0.5",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.4.0",
    "jsdom": "^24.1.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  }
}
